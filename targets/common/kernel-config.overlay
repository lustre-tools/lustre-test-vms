# Shared kernel config overlay, applied best effort to every target's
# kernel.  Unlike kernel-config.fragment, nothing here is forced: an
# entry the kernel's config cannot take is reported in the build log
# and in the kernel's meta.json (config_overlay_missed), and the build
# goes on.  A target overrides an entry by setting the symbol in its
# kernels.config in targets.yaml, or drops it with a null value
# (CONFIG_DRM: null), which leaves the symbol to the kernel's own
# config.

# ko2iblnd (Lustre configures --with-o2ib=yes) and SoftRoCE.
CONFIG_INFINIBAND=m
CONFIG_INFINIBAND_USER_ACCESS=m
CONFIG_INFINIBAND_ADDR_TRANS=y
CONFIG_RDMA_RXE=m

# SMC sockets: SMC-R runs over any RoCE device, shmrdma's included, so
# TCP programs (smc_run) and socklnd (with socket_smc=1) can use it.
# Its capability handshake is a TCP SYN option in the core TCP stack,
# so it cannot be added as a module later.  SMC_LO is the in-guest
# loopback ISM (6.11 and later).
CONFIG_SMC=m
CONFIG_SMC_DIAG=m
CONFIG_SMC_LO=y

# libcfs finds kallsyms_lookup_name through a kprobe: without them
# every Lustre module fails to load with -EOPNOTSUPP.  arm64's
# defconfig leaves them off.
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y

# Hardware a headless virtio microvm never has.  Each takes the
# drivers under it along; from a 46 minute debian13 build they were
# about 6300 of the module compiles.
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WIRELESS=n
CONFIG_WLAN=n
CONFIG_STAGING=n

# Debug and fault-injection facilities that cost nothing until switched
# on at runtime or boot, so test kernels need no rebuild to use them.
# Fault injection is configured through debugfs (failslab and
# fail_page_alloc sit behind static keys since 6.11); fail_function
# and BPF error override work on ALLOW_ERROR_INJECTION functions.
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAIL_MAKE_REQUEST=y
CONFIG_FUNCTION_ERROR_INJECTION=y
CONFIG_FAIL_FUNCTION=y
CONFIG_BPF_KPROBE_OVERRIDE=y
# Leak detection: boot with kmemleak=on.
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_DEFAULT_OFF=y
# Page use-after-free detection: boot with debug_pagealloc=on.
CONFIG_DEBUG_PAGEALLOC=y
CONFIG_DEBUG_PAGEALLOC_ENABLE_DEFAULT=n
# jbd2 debug messages, gated by the jbd2_debug module parameter.
CONFIG_JBD2_DEBUG=y
# Device-mapper fault targets (bad sectors, delays), modules only.
CONFIG_DM_DUST=m
CONFIG_DM_DELAY=m
