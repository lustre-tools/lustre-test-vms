    sp.add_argument(
        "--no-unload",
        dest="no_unload",
        action="store_true",
        help="Don't try to unload Lustre modules first",
    )
    sp.set_defaults(func=cmd_make_reinstall)

    # -- llmount --
    sp = sub.add_parser(
        "llmount",
        parents=[common],
        help="Mount (or unmount) Lustre inside a VM",
    )
    _llm_vm = sp.add_argument("vm", help="VM name")
    _llm_vm.completer = complete_vms  # type: ignore[attr-defined]
    sp.add_argument(
