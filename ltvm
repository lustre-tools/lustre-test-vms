        sp.add_argument(
            "--skip-lustre",
            action="store_true",
            default=False,
            help="Skip building Lustre against the target kernel "
            "(and skip the post-Lustre snapshot).  Useful for fast "
            "kernel-only iteration.",
        )
        sp.set_defaults(func=cmd_build_all)

    bap = build_sub.add_parser(
        "all",
        parents=[
            common,
            kernel_arg,
            force_arg,
            force_compat_arg,
            variant_arg,
            zfs_arg,
