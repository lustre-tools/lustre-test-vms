        help="Build container + kernel + Lustre + image from scratch",
    )
    _add_build_all_args(bap)

    bcp = build_sub.add_parser(
        "container",
        parents=[common, variant_arg],
        help="Build the build container for a target",
    )
    _add_target_arg(bcp, required=True)
    bcp.set_defaults(func=cmd_build_container)

    bkp = build_sub.add_parser(
        "kernel",
        parents=[common, kernel_arg, force_arg, force_compat_arg],
        help="Build the kernel for a target",
    )
    _add_target_arg(bkp, required=True)
    bkp.add_argument(
        "--lustre-tree", help="Path to Lustre source tree (default: cwd)"
    )
    bkp.set_defaults(func=cmd_build_kernel)

    bip = build_sub.add_parser(
        "image",
        parents=[common, kernel_arg, force_arg, force_compat_arg, variant_arg],
        help="Build the VM base image for a target",
    )
    _add_target_arg(bip, required=True)
    bip.add_argument(
        "--no-lustre",
        action="store_true",
        help="Do not bake Lustre modules+userland into the image, "
        "even if staging is present",
    )
    bip.add_argument(
        "--lustre-tree",
        default=None,
        metavar="PATH",
        help="Path to Lustre source tree (default: cwd) -- used to "
        "find per-kernel Lustre staging to bake into the image",
    )
    bip.set_defaults(func=cmd_build_image)

    # Note: build lustre's --force has a slightly different meaning
    # ("Clean and reconfigure before building") than the shared help text,
    # but the flag behaviour is identical.
    blp = build_sub.add_parser(
        "lustre",
        parents=[
            common,
            kernel_arg,
            force_arg,
            force_compat_arg,
            variant_arg,
            zfs_arg,
        ],
        help="Build a Lustre source tree against the target kernel build-tree",
    )
    _add_target_arg(blp, required=True)
    blp.add_argument(
        "--lustre-tree", help="Path to Lustre source tree (default: cwd)"
    )
    blp.add_argument(
        "--enable-server",
        action="store_true",
        default=False,
        help="Force --enable-server (default: per targets.yaml)",
    )
    blp.add_argument(
        "--disable-server",
        action="store_true",
        default=False,
        help="Force --disable-server",
