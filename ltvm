    sp.set_defaults(func=cmd_make_uninstall)

    sp = sub.add_parser(
        "make-reinstall",
        parents=[common, kernel_arg, force_compat_arg],
        help="make-uninstall followed by make-install, on THIS machine",
    )
    _add_make_common(sp)
    sp.add_argument(
        "--lustre-tree",
        default=None,
        help="Path to the Lustre source tree (default: cwd)",
    )
    sp.add_argument(
        "--zfs",
        action="store_true",
        default=False,
