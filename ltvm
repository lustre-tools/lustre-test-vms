def _reconcile_target_args(args: argparse.Namespace) -> int | None:
    """Reconcile positional `target` vs --target flag.

    Both forms are first-class.  If both are given and disagree, this
    prints a clear error and returns EXIT_ERROR so the caller can abort.
    On success (or when neither form applies), returns None and sets
    args.target to the resolved value (positional takes precedence;
    falls back to the --target flag).

    Subcommands that don't use --target at all (e.g. `list`, `destroy`)
    are left untouched.
    """
    flag = getattr(args, _TARGET_FLAG_DEST, None)
    pos = getattr(args, "target", None)
    # If neither attribute was set by argparse, the subcommand doesn't
    # take a target; nothing to do.
    has_pos_attr = hasattr(args, "target")
    has_flag_attr = hasattr(args, _TARGET_FLAG_DEST)
    if not has_pos_attr and not has_flag_attr:
        return None

    if pos is not None and flag is not None and pos != flag:
        sys.stderr.write(
            f"error: --target {flag!r} conflicts with positional "
            f"target {pos!r}; pass only one\n"
        )
        return EXIT_ERROR

    resolved = pos if pos is not None else flag
    if has_pos_attr:
        args.target = resolved
    # Drop the internal sentinel so downstream code doesn't see it.
    if has_flag_attr:
        try:
            delattr(args, _TARGET_FLAG_DEST)
        except AttributeError:
            pass
    return None


# Options whose value is a flag for some *other* program, and so
# almost always starts with "-".  argparse reads a space-separated
# "-value" as the next option and fails with "expected one argument",
# which made the documented, obvious invocation
# `--configure --with-o2ib=yes` an error.
_DASH_VALUED_OPTIONS = frozenset({"--configure"})


def _known_option_strings(parser: argparse.ArgumentParser) -> set[str]:
    """Every option string this parser and its subparsers accept.

    Walks _actions/choices because argparse exposes no public view of a
    subparser tree.  Used only to tell "a flag meant for configure"
    from "an ltvm flag the user put in the wrong place".
    """
    seen: set[str] = set()
    stack = [parser]
    while stack:
        cur = stack.pop()
        for action in cur._actions:
            seen.update(action.option_strings)
            choices = getattr(action, "choices", None)
            if isinstance(choices, dict):
                stack.extend(
                    c
                    for c in choices.values()
                    if isinstance(c, argparse.ArgumentParser)
                )
    return seen


def _join_dash_valued_options(
    argv: list[str], known_options: set[str]
) -> list[str]:
    """Rewrite `--configure --with-o2ib=yes` to the `=` form.

    Only when the value looks like a flag and is not an ltvm option of
    its own: `--configure --jobs 4` stays an error, because that is a
    misplaced ltvm flag rather than something meant for configure.
    `--` is left alone; it is the end-of-options marker.
    """
    out: list[str] = []
    i = 0
    while i < len(argv):
        tok = argv[i]
        if tok in _DASH_VALUED_OPTIONS and i + 1 < len(argv):
            value = argv[i + 1]
            if (
                value.startswith("-")
                and value != "--"
                and value not in known_options
            ):
                out.append(f"{tok}={value}")
                i += 2
                continue
        out.append(tok)
        i += 1
    return out


def main() -> int:
    parser = build_parser()
    # argcomplete hooks here when invoked via the bash completion shim
    # (detected via _ARGCOMPLETE env var).  In that mode it prints
    # completions and exits -- nothing below runs.  When not completing,
    # this is a no-op.
    try:
        import argcomplete

        argcomplete.autocomplete(parser)
    except ImportError:
        pass
    args = parser.parse_args(
        _join_dash_valued_options(sys.argv[1:], _known_option_strings(parser))
    )

    level = logging.DEBUG if getattr(args, "verbose", False) else logging.INFO
    logging.basicConfig(level=level, format="%(name)s: %(message)s")

    if not args.command:
        parser.print_help()
        return EXIT_ERROR

    rc = _reconcile_target_args(args)
    if rc is not None:
        return rc

    # Daily self-update nag (interactive TTYs only, skipped for
    # --json, and skipped entirely for `install` to avoid recursing
    # during the install that just wrote our baked version).  See
    # ltvm_pkg/update_check.py for the full state machine.
    #
    # `completion` is skipped for a different reason: the documented way
    # to use it is `eval "$(ltvm completion)"` from a shell rc file, so
    # it runs once per new terminal.  A nag there would print into every
    # shell the user opens, and the check's state file would be written
    # by however many shells start at once.
    if args.command not in ("install", "completion"):
        try:
            from ltvm_pkg.update_check import maybe_check_for_updates

            maybe_check_for_updates(use_json=bool(getattr(args, "json", False)))
        except Exception as e:  # noqa: BLE001
            # Update check is cosmetic -- a failure here must never
            # block the user's actual command.
            logging.getLogger("ltvm.update_check").debug(
                "update check skipped: %s", e
            )

    result: int = args.func(args)

    # Note what ran, then send if a week is up.  Skipped for `install`
    # (still in flight) and for `telemetry` itself (the detached sender
    # runs `ltvm telemetry send`, which would otherwise spawn another).
    # Runs after the command so it can never delay it, and swallows
    # everything: telemetry must not be able to fail a build.
    # `completion` is excluded for the same reason as above: it runs
    # from shell rc files, and counting one invocation per terminal
    # opened would drown out every command a human actually ran.
    if args.command not in ("install", "telemetry", "completion"):
        try:
            from ltvm_pkg.telemetry import maybe_send, record

            record(args, result)
            maybe_send()
        except Exception as e:  # noqa: BLE001
            logging.getLogger("ltvm.telemetry").debug(
                "telemetry skipped: %s", e
            )

    return result


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        # Shell convention for Ctrl-C termination.
        sys.stderr.write("\naborted\n")
        sys.exit(130)
