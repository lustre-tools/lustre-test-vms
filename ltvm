# Dest used for the --target flag on subcommands that ALSO accept a
# positional target.  We don't write to `args.target` directly from
# --target so that both sources can be reconciled (and a conflict
# detected) after argparse completes.  See _reconcile_target_args().
_TARGET_FLAG_DEST = "_target_flag"


def _add_target_arg(
    subparser: argparse.ArgumentParser,
    *,
    required: bool = False,
    positional_name: str = "target",
) -> None:
    """Attach both a positional target and a --target flag.

    Both are optional at parse time (nargs="?" / default=None); the
    cli.py reconciler enforces presence/conflict after parsing.  The
    --target flag help text is suppressed to keep --help output clean
    --the positional form is the primary, documented spelling.
    """
    help_text = "OS target (e.g. rocky9); also accepts --target"
    if required:
        help_text += " (required)"
    pos = subparser.add_argument(
        positional_name,
        nargs="?",
        default=None,
        help=help_text,
    )
    pos.completer = complete_targets  # type: ignore[attr-defined]
    flag = subparser.add_argument(
        "--target",
        dest=_TARGET_FLAG_DEST,
        default=None,
        help=argparse.SUPPRESS,
    )
    flag.completer = complete_targets  # type: ignore[attr-defined]


# Completers attached by option string in one pass over the finished
# parser (see _attach_completers).  These are the options whose meaning
# is the same everywhere they appear, and most of them appear a lot:
# --lustre-tree is declared at eight separate call sites, --arch on
# every subcommand via the `common` parent.  Doing it here means a
# subcommand added later is covered without anyone remembering to.
#
# Options NOT in this table, on purpose:
#   --kernel   `create --kernel` is an explicit kernel *path*, while
#              everywhere else it is a version name from targets.yaml.
#              Wired per-command instead, so the two never get confused.
#   --image, --ssh-key, --tarball, --output
#              File paths -- argcomplete's default FilesCompleter is
#              already the right answer, and naming them here would
#              only risk overriding it with something worse.
_COMPLETERS_BY_OPTION: dict[str, Any] = {
    "--arch": complete_arches,
    "--build": complete_directories,
    "--lustre-tree": complete_directories,
    "--mod-dir": complete_directories,
    "--mofed-version": complete_mofed_versions,
    "--outdir": complete_directories,
    "--variant": complete_variants,
    "--zfs-version": complete_zfs_versions,
}


def _attach_completers(parser: argparse.ArgumentParser) -> None:
    """Attach _COMPLETERS_BY_OPTION across the whole subparser tree.

    Only fills arguments that have no completer yet, so an explicit
    per-command assignment always wins over the table -- the table is
    the default, not an override.
    """
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            # Aliases share one parser object; visiting it twice is
            # harmless (the second pass finds completers already set).
            for subparser in action.choices.values():
                _attach_completers(subparser)
            continue
        if hasattr(action, "completer"):
            continue
        for opt in action.option_strings:
            completer = _COMPLETERS_BY_OPTION.get(opt)
            if completer is not None:
                action.completer = completer  # type: ignore[attr-defined]
                break


class _HideSuppressedSubcommands(argparse.HelpFormatter):
    """Hide subcommands registered with help=argparse.SUPPRESS."""

    def _format_action(self, action: argparse.Action) -> str:
        if action.help == argparse.SUPPRESS:
            return ""
        return super()._format_action(action)

    def _metavar_formatter(
        self, action: argparse.Action, default_metavar: str
    ) -> Any:
        # For subparser actions, strip suppressed choices from the metavar.
        if hasattr(action, "_name_parser_map"):
            # Aliases point to the same parser instance as the canonical
            # name, so dedupe by id() to keep only the first (canonical)
            # entry per parser.
            seen: set[int] = set()
            visible: list[str] = []
            for name, sp in action._name_parser_map.items():
                if sp.description == argparse.SUPPRESS:
                    continue
                if getattr(sp, "_defaults", {}).get("func") is None:
                    continue
                if id(sp) in seen:
                    continue
                seen.add(id(sp))
                visible.append(name)

            def fmt(tuple_size: int) -> tuple[Any, ...]:
                if tuple_size != 1:
                    return (tuple(visible),)
                return ("{" + ",".join(visible) + "}",)

            return fmt
        return super()._metavar_formatter(action, default_metavar)


def build_parser() -> argparse.ArgumentParser:
    # Common flags accepted by all subcommands
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument(
        "--json",
        action="store_true",
        default=False,
        help="Machine-readable JSON output",
    )
    common.add_argument(
        "-v", "--verbose", action="store_true", help="Enable verbose logging"
    )
    common.add_argument(
        "--arch",
        default=None,
        help="Target CPU architecture override (e.g. aarch64). "
        "Defaults to the target's configured arch (usually x86_64).",
    )

    # Shared --kernel flag for subcommands that operate on
    # a specific kernel version within a target
    kernel_arg = argparse.ArgumentParser(add_help=False)
    _kernel_action = kernel_arg.add_argument(
        "--kernel",
        default=None,
        help="Kernel version (default: from targets.yaml)",
    )
    _kernel_action.completer = complete_kernels  # type: ignore[attr-defined]

    # Shared --force flag for build subcommands
    force_arg = argparse.ArgumentParser(add_help=False)
    force_arg.add_argument(
        "--force",
        action="store_true",
        help="Rebuild even if inputs unchanged",
    )

    # Shared --variant flag for build subcommands that operate on a
    # target's variant artifacts (e.g. MOFED).  Default 'base' is the
    # pre-variant behavior.
    variant_arg = argparse.ArgumentParser(add_help=False)
    _variant_action = variant_arg.add_argument(
        "--variant",
        default="base",
        metavar="NAME",
        help="Target variant to build (default: base). "
        "E.g. 'mofed' to layer MOFED on top of the base.",
    )
    _variant_action.completer = complete_variants  # type: ignore[attr-defined]
    variant_arg.add_argument(
        "--mofed-version",
        default=None,
        metavar="VER",
        help="Override mofed_version param for the mofed variant. "
        "Folds into the variant's input hash.",
    )

    # Shared ZFS flags.  ZFS is a per-build option, not a property of a
    # target: it is built between the kernel and Lustre and installed
    # into the VM at deploy time, so nothing about a target's
    # container, kernel or image artifacts depends on it.
    zfs_arg = argparse.ArgumentParser(add_help=False)
    zfs_arg.add_argument(
        "--zfs",
        action="store_true",
        default=False,
        help="Build ZFS against this kernel and build Lustre "
        "--with-zfs, producing osd-zfs alongside osd-ldiskfs",
    )
    zfs_arg.add_argument(
        "--zfs-version",
        default=None,
        metavar="VER",
        help="OpenZFS release to use (default: the target's zfs.version "
        "in targets.yaml).  Implies --zfs.",
    )

    # Shared --force-compat flag for subcommands that gate on Lustre-tree
    # compatibility (build + deploy paths).  'refuse' status is bypassed
    # when set; hard errors (parse/IO) are never bypassed.
    force_compat_arg = argparse.ArgumentParser(add_help=False)
    force_compat_arg.add_argument(
        "--force-compat",
        action="store_true",
        help=(
            "Override a Lustre-tree compatibility refusal (not errors).  "
            "Only affects paths that actually invoke the compat gate: "
            "build commands always, and deploy-lustre only when it "
            "rebuilds from source (not bundled snapshots or "
            "--userspace-only, which rely on prior-vetted artifacts)."
        ),
    )

    p = argparse.ArgumentParser(
        prog="ltvm",
        description="Lustre test VM infrastructure CLI",
        formatter_class=_HideSuppressedSubcommands,
    )
    p.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {LTVM_VERSION}",
    )

    sub = p.add_subparsers(dest="command")

    # -- install (host setup) --
    sp = sub.add_parser(
        "install",
        parents=[common],
        help="Install ltvm: QEMU, network, scripts, SSH, ltvm to PATH",
    )
    sp.add_argument(
        "--qemu", action="store_true", help="Build and install QEMU only"
    )
    sp.add_argument(
        "--network", action="store_true", help="Configure bridge + dnsmasq only"
    )
    sp.add_argument(
        "--install",
        action="store_true",
        help="Install scripts and VM directories only",
    )
    sp.add_argument(
        "--ssh", action="store_true", help="Configure host SSH only"
    )
    sp.add_argument(
        "--verify",
        action="store_true",
        help="Check existing setup (no changes)",
    )
    sp.add_argument(
        "--force",
        action="store_true",
        help="Force rebuild of installed components",
    )
    sp.add_argument(
        "--subnet",
        default="192.168.100",
        help="Bridge subnet (default: 192.168.100)",
    )
    sp.set_defaults(func=cmd_setup)

    # -- update --
    sp = sub.add_parser(
        "update",
        parents=[common],
        help="Pull the latest ltvm from GitHub (git fast-forward)",
    )
    sp.add_argument(
        "--check",
        action="store_true",
        help="Check whether an update is available without pulling",
