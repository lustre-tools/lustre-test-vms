    def _add_build_all_args(sp: argparse.ArgumentParser) -> None:
        """Attach the `build all` / `target build` argument shape.

        Factored out so both entry points share one definition --
        adding an option in one place keeps both spellings in sync.
        """
        _add_target_arg(sp, required=True)
        sp.add_argument(
            "--lustre-tree", help="Path to Lustre source tree (default: cwd)"
